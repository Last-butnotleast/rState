{
  "name": "rstate-core-test-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "reference": "node scripts/fetch-reference.mjs",
    "wasm": "node scripts/build-wasm.mjs",
    "prepare:engines": "npm run reference && npm run wasm",
    "dev": "npm run prepare:engines && vite",
    "dev:prepared": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run prepare:engines && npm run typecheck && vite build",
    "test": "npm run prepare:engines && playwright test",
    "test:prepared": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
